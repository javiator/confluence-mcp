# Confluence Configuration
CONFLUENCE_BASE_URL="https://your-domain.atlassian.net/wiki"
CONFLUENCE_EMAIL="your-email@example.com"
CONFLUENCE_API_TOKEN="your-atlassian-api-token"

# LLM Configuration (Choose at least one provider)

# OpenAI
OPENAI_API_KEY="sk-..."

# Anthropic
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini
GOOGLE_API_KEY="AIza..."

# Agent Settings
# Provider: openai, anthropic, or google
LLM_PROVIDER="openai"
# Model: gpt-4o, claude-3-5-sonnet-20240620, gemini-1.5-pro, etc.
LLM_MODEL="gpt-4o"

# Audio Transcription (when using Gemini for voice input)
# Model for audio transcription: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp, etc.
GEMINI_AUDIO_MODEL="gemini-2.5-flash-exp"

# Optional: Path to config.json if not in CWD
# CONFLUENCE_MCP_CONFIG="/path/to/config.json"

# ── AWS Bedrock AgentCore ─────────────────────────────────────────────────────
# Set USE_AGENTCORE=true to route Chainlit messages to the hosted AgentCore
# agent instead of running the LangGraph loop locally.
# See AGENTCORE_MIGRATION.md for the full setup guide.
USE_AGENTCORE="false"

# The AgentCore agent ID and alias ID — filled in after you create the agent.
# Find these in the AWS Console under Bedrock → AgentCore → your agent.
AGENTCORE_AGENT_ID=""
AGENTCORE_AGENT_ALIAS_ID="TSTALIASID"
